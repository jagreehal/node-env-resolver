{
  "name": "express-app-example",
  "version": "1.0.23",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "docker:build": "docker build -t express-app-example .",
    "docker:run": "docker run -p 3000:3000 --env-file .env express-app-example",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1155.0",
    "@aws-sdk/client-ssm": "^3.1155.0",
    "express": "^5.3.0",
    "node-env-resolver": "workspace:*",
    "node-env-resolver-aws": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
