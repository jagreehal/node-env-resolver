{
  "name": "aws-lambda-example",
  "version": "1.0.23",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "package": "npm run build && zip -r function.zip dist/ node_modules/",
    "dev": "tsx src/handler.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1155.0",
    "@aws-sdk/client-ssm": "^3.1155.0",
    "node-env-resolver": "workspace:*",
    "node-env-resolver-aws": "workspace:*"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
