{
  "name": "node-env-resolver",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "dotenv -- turbo run dev --no-cache --parallel --continue",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "oxlint packages examples",
    "lint:fix": "oxlint packages examples --fix",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "example:basic": "pnpm --filter simple-example dev",
    "example:express": "pnpm --filter express-app-example dev",
    "example:lambda": "pnpm --filter aws-lambda-example dev",
    "release": "pnpm changeset publish",
    "quality": "pnpm lint && turbo run build type-check test"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "oxlint": "^1.86.0",
    "eslint-plugin-import-zod": "^1.2.1"
  },
  "packageManager": "pnpm@10.26.0",
  "dependencies": {
    "@changesets/cli": "^3.0.3"
  }
}
