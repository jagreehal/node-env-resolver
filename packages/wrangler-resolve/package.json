{
  "name": "wrangler-resolve",
  "version": "1.0.2",
  "description": "Cloudflare Workers integration for node-env-resolver (wrangler dev/deploy, FIFO secrets, hot reload)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./handlers": {
      "types": "./dist/handlers.d.ts",
      "import": "./dist/handlers.js",
      "default": "./dist/handlers.js"
    },
    "./wrangler": {
      "types": "./dist/wrangler.d.ts",
      "import": "./dist/wrangler.js",
      "default": "./dist/wrangler.js"
    },
    "./chunking": {
      "types": "./dist/chunking.d.ts",
      "import": "./dist/chunking.js",
      "default": "./dist/chunking.js"
    },
    "./fifo": {
      "types": "./dist/fifo.d.ts",
      "import": "./dist/fifo.js",
      "default": "./dist/fifo.js"
    }
  },
  "bin": {
    "wrangler-resolve": "./bin/wrangler-resolve.js",
    "cloudflare-resolve": "./bin/wrangler-resolve.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "NODE_ENV=production tsup && tsc -p tsconfig.build.json",
    "build:dev": "tsup && tsc -p tsconfig.build.json",
    "build:dts": "tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepublishOnly": "pnpm build && pnpm type-check"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "wrangler",
    "secrets",
    "fifo",
    "environment",
    "env",
    "config",
    "node-env-resolver"
  ],
  "author": {
    "name": "Jagvinder Singh Reehal",
    "email": "jag@jagreehal.com",
    "url": "https://jagreehal.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/node-env-resolver.git",
    "directory": "packages/wrangler-resolve"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "node-env-resolver": "^6.7.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "node-env-resolver": "workspace:*",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
