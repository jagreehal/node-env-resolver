{
  "name": "node-env-resolver-aws",
  "version": "13.0.0",
  "description": "AWS resolvers for node-env-resolver (Secrets Manager, SSM Parameter Store)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./handlers": {
      "types": "./dist/handlers.d.ts",
      "import": "./dist/handlers.js",
      "require": "./dist/handlers.cjs",
      "default": "./dist/handlers.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.ts"
      ],
      "handlers": [
        "./dist/handlers.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "NODE_ENV=production tsup && tsc -p tsconfig.build.json",
    "build:dev": "tsup && tsc -p tsconfig.build.json",
    "build:dts": "tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepublishOnly": "pnpm build && pnpm type-check"
  },
  "keywords": [
    "aws",
    "secrets-manager",
    "ssm",
    "parameter-store",
    "environment",
    "env",
    "config",
    "node-env-resolver"
  ],
  "author": {
    "name": "Jagvinder Singh Reehal",
    "email": "jag@jagreehal.com",
    "url": "https://jagreehal.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/node-env-resolver.git",
    "directory": "packages/node-env-resolver-aws"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/credential-providers": "^3.1141.0",
    "@aws-sdk/client-secrets-manager": "^3.1141.0",
    "@aws-sdk/client-ssm": "^3.1141.0"
  },
  "peerDependencies": {
    "node-env-resolver": "^6.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "node-env-resolver": "workspace:*",
    "@types/node": "^26.6.3",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
