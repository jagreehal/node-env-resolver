{
  "name": "node-env-resolver-vite",
  "version": "2.5.1",
  "description": "Zero-config Vite integration for node-env-resolver with client/server split",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "NODE_ENV=production tsup && tsc -p tsconfig.build.json",
    "build:dev": "tsup && tsc -p tsconfig.build.json",
    "build:dts": "tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsup --watch",
    "prepublishOnly": "pnpm build && pnpm type-check"
  },
  "keywords": [
    "vite",
    "environment",
    "env",
    "config",
    "typescript",
    "type-safe",
    "zero-config",
    "vue",
    "react",
    "svelte",
    "solid",
    "astro"
  ],
  "author": {
    "name": "Jagvinder Singh Reehal",
    "email": "jag@jagreehal.com",
    "url": "https://jagreehal.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/node-env-resolver.git",
    "directory": "packages/vite-resolver"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vite": "^8.3.1"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "node-env-resolver": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
